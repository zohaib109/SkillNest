MONGODB_URI=mongodb://127.0.0.1:27017/skillnest_dev?replicaSet=rs0
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=dummy_google_client_id
GOOGLE_CLIENT_SECRET=dummy_google_client_secret

# Optional server runtime JSON for the admin payments page.
# PAYMENT_RECEIVING_ACCOUNTS=

# Local development only. Requires 127.0.0.1, a skillnest_sandbox_* database,
# directConnection=true in MONGODB_URI, and a loopback BETTER_AUTH_URL.
# SKILLNEST_ENABLE_SANDBOX_PAYMENTS=true

# Smoke tests only. Set in .env.smoke.local or export before pnpm test:smoke.
# SMOKE_MONGODB_URI=mongodb://127.0.0.1:27017/skillnest_smoke?replicaSet=rs0
